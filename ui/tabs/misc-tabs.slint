import { EffectToggle } from "../effect-slider.slint";
import { CheckBox, LineEdit } from "std-widgets.slint";

// Direct Mode, Scout Mode und Decoder waren früher drei eigene Unterreiter,
// wirkten dort aber jeweils sehr leer (nur ein Schalter + Beschreibung
// bzw. 3 Radiobuttons). Jetzt zu einem Reiter "Modi & Decoder"
// zusammengelegt.
export component ModiDecoderTab inherits VerticalLayout {
    in-out property <bool> direct-mode-on: false;
    // Solange das Gerät nach einem Umschalten neu verbindet (ca. 2-5s),
    // ist der Schalter gesperrt – ein Klick mitten in der Neuenumeration
    // schaltet sonst sofort wieder zurück (Issue #1).
    in property <bool> direct-mode-busy: false;
    // Direct Mode ist ein echtes Hardware-Register (`5a 39 03 00 05`,
    // per Capture `Directmode ein-aus.pcapng` bestätigt 2026-08-24) –
    // derselbe Zustand, den auch der physische MODE-Knopf schaltet.
    // Achtung: der Knopf ändert das Register, ohne dass die App es
    // bisher mitbekommt (Status-Bitfeld noch nicht sicher entschlüsselt,
    // siehe HANDOFF.md Abschnitt 7) – dieser Schalter kann daher vom
    // echten Gerätezustand abweichen.
    in-out property <bool> scout-on: false;
    in-out property <int> decoder-mode: 1; // 0=Normal 1=Voll 2=Nacht

    // Scout-Mode-Zugriffstaste (Hotkey): rein UI-seitig vorbereitet. Ein
    // echter globaler Tastatur-Hook bräuchte eine eigene Rust-Bibliothek
    // (z.B. global-hotkey-Crate) – noch nicht angebunden.
    in-out property <bool> scout-hotkey-enabled: false;
    in-out property <string> scout-hotkey-text: "";

    callback direct-mode-toggled(bool);
    callback scout-toggled(bool);
    callback decoder-mode-changed(int);

    padding: 16px;
    spacing: 24px;
    alignment: start;

    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            EffectToggle {
                label: "Direct Mode";
                checked <=> direct-mode-on;
                enabled: !direct-mode-busy;
                toggled(on) => { direct-mode-on = on; direct-mode-toggled(on); }
            }
            Rectangle { horizontal-stretch: 1; }
            Image {
                source: @image-url("../assets/dm-logo.svg");
                width: 140px;
                height: 64px;
                image-fit: contain;
            }
        }
        Text {
            wrap: word-wrap;
            font-size: 16px;
            color: gray;
            text: @tr("Im Direct Mode erhalten Sie Audio in seiner reinsten Form direkt von der Quelle. Alle Audioeffekte werden nicht auf die Ausgabe angewendet.");
        }
    }

    Rectangle { height: 1px; background: #e0e0e0; }

    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            EffectToggle {
                label: "Scout Mode";
                checked: scout-on;
                toggled(on) => { scout-on = on; scout-toggled(on); }
            }
            Rectangle { horizontal-stretch: 1; }
            Image {
                source: @image-url("../assets/sm-logo.svg");
                width: 140px;
                height: 54px;
                image-fit: contain;
            }
        }
        Text {
            wrap: word-wrap;
            font-size: 16px;
            color: gray;
            text: @tr("Entwickelt, um Ihnen zu helfen, das zu hören, was Sie nicht sehen können, wie Schritte, Rede und Waffenwechsel.");
        }
        Text {
            wrap: word-wrap;
            font-size: 16px;
            color: gray;
            text: @tr("Einige Audioeffekte werden nicht für die Ausgabe übernommen.");
        }

        HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: @tr("Zugriffstaste");
                checked: scout-hotkey-enabled;
                toggled => { scout-hotkey-enabled = self.checked; }
            }
        }
        Text {
            wrap: word-wrap;
            font-size: 14px;
            color: gray;
            text: @tr("Um ein Hotkey zuzuweisen, drücken Sie die Taste auf der Tastatur mit der Kombination von Strg, Alt oder Shift.");
        }
        LineEdit {
            width: 260px;
            enabled: scout-hotkey-enabled;
            placeholder-text: @tr("Klicken Sie, um den Tastaturanschlag zuzuweisen");
            text: scout-hotkey-text;
            edited(t) => { scout-hotkey-text = t; }
        }
    }

    Rectangle { height: 1px; background: #e0e0e0; }

    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            Text { text: @tr("Decoder"); font-weight: 700; font-size: 18px; }
            Rectangle { horizontal-stretch: 1; }
            Image {
                source: @image-url("../assets/decoder-logo.svg");
                width: 140px;
                height: 72px;
                image-fit: contain;
            }
        }
        Text {
            wrap: word-wrap;
            font-size: 16px;
            color: gray;
            text: @tr("Spielen Sie Ihre Dolby Digital Medien einfach mit dem integrierten Decoder.");
        }
        for label[i] in [@tr("Normal"), @tr("Voll"), @tr("Nacht")]: HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 16px; height: 16px;
                border-radius: 8px;
                border-width: 2px;
                border-color: decoder-mode == i ? orange : gray;
                background: decoder-mode == i ? orange : transparent;
                TouchArea {
                    clicked => { decoder-mode = i; decoder-mode-changed(i); }
                }
            }
            Text { text: label; font-size: 16px; }
        }
    }
}
