import { EffectToggle, CompactComboBox } from "../effect-slider.slint";
import { Slider } from "std-widgets.slint";

export component CrystalVoiceTab inherits VerticalLayout {
    in-out property <bool> noise-reduction-on: false;
    in-out property <float> noise-reduction-level: 0;

    in-out property <bool> aec-on: true;

    in-out property <bool> smart-volume-on: false;

    // Voice-Morph-/Mikrofon-Equalizer-Listen: nur "Roboter" bzw.
    // "Pitch-Reduzierung" stammen aus dem Original-Screenshot, der Rest
    // ist eine plausible Ergänzung (keine Capture-Bestätigung für die
    // vollständige Liste/Reihenfolge) – bei Gelegenheit gegenprüfen.
    in-out property <bool> voice-morph-on: false;
    in-out property <[string]> voice-morph-profiles: ["Roboter", "Alien", "Weiblich", "Männlich", "Baby", "Radio", "Telefon", "Höhle"];
    in-out property <int> voice-morph-profile-index: 0;

    in-out property <bool> mic-eq-on: false;
    in-out property <[string]> mic-eq-profiles: ["Pitch-Reduzierung", "Pitch-Erhöhung", "Nah", "Fern"];
    in-out property <int> mic-eq-profile-index: 0;

    // Breite/Einrückung für Noise-Reduction-, Voice-Morph- und Mikrofon-
    // Equalizer-Zeile: gleiche Label-Breite, damit Slider und beide
    // Auswahlfelder exakt übereinander stehen und gleich lang sind,
    // unabhängig von der (unterschiedlich langen) Beschriftung.
    property <length> profile-label-width: 250px;
    property <length> profile-box-width: 200px;

    // param-id (0x95-Namespace angenommen), value
    callback param-changed(int, float);
    callback voice-morph-profile-changed(int);
    callback mic-eq-profile-changed(int);

    spacing: 16px;
    padding: 16px;

    HorizontalLayout {
        EffectToggle {
            width: profile-label-width;
            label: "Noise Reduction";
            checked: noise-reduction-on;
            toggled(on) => { noise-reduction-on = on; param-changed(4, on ? 1.0 : 0.0); }
        }
        Slider {
            width: profile-box-width;
            minimum: 0; maximum: 100;
            value: noise-reduction-level;
            enabled: noise-reduction-on;
            changed(v) => { noise-reduction-level = v; param-changed(5, v); }
        }
    }
    Text {
        text: "Reduzieren Sie statische Hintergrundgeräusche bei ausgehendem Audio während Telefonkonferenzen.";
        wrap: word-wrap;
        font-size: 16px;
        color: gray;
    }

    EffectToggle {
        label: "Acoustic Echo Cancellation";
        checked: aec-on;
        toggled(on) => { aec-on = on; param-changed(0, on ? 1.0 : 0.0); }
    }
    Text {
        text: "Beseitigen Sie Echos, die Ihre Konversation stören.";
        wrap: word-wrap;
        font-size: 16px;
        color: gray;
    }

    EffectToggle {
        label: "Smart Volume";
        checked: smart-volume-on;
        // Param-ID per Windows-Capture bestätigt (0x2c) – vorher fälschlich
        // für Voice Morph gehalten, siehe HANDOFF.md.
        toggled(on) => { smart-volume-on = on; param-changed(44, on ? 1.0 : 0.0); }
    }
    Text {
        text: "Gut verstanden werden, ohne rufen oder flüstern zu müssen.";
        wrap: word-wrap;
        font-size: 16px;
        color: gray;
    }

    HorizontalLayout {
        EffectToggle {
            width: profile-label-width;
            label: "Voice Morph";
            checked: voice-morph-on;
            // Param-ID per Windows-Capture korrigiert: 0x0a (10), nicht 0x2c
            // (das ist Smart Volume, siehe oben) – siehe HANDOFF.md.
            toggled(on) => { voice-morph-on = on; param-changed(10, on ? 1.0 : 0.0); }
        }
        CompactComboBox {
            width: profile-box-width;
            item-font-size: 14px;
            model: voice-morph-profiles;
            current-index: voice-morph-profile-index;
            enabled: voice-morph-on;
            selected(i) => {
                voice-morph-profile-index = i;
                voice-morph-profile-changed(i);
            }
        }
    }
    Text {
        text: "Morphen Sie Ihre Stimme in verschiedene Charaktere und Akzente.";
        wrap: word-wrap;
        font-size: 16px;
        color: gray;
    }

    HorizontalLayout {
        EffectToggle {
            width: profile-label-width;
            label: "Mikrofon-Equalizer";
            checked: mic-eq-on;
            toggled(on) => { mic-eq-on = on; param-changed(19, on ? 1.0 : 0.0); }
        }
        CompactComboBox {
            width: profile-box-width;
            item-font-size: 14px;
            model: mic-eq-profiles;
            current-index: mic-eq-profile-index;
            enabled: mic-eq-on;
            selected(i) => {
                mic-eq-profile-index = i;
                mic-eq-profile-changed(i);
            }
        }
    }
    Text {
        text: "Verbessern Sie die Mikrofonleistung und die Qualität Ihrer Stimme.";
        wrap: word-wrap;
        font-size: 16px;
        color: gray;
    }

    HorizontalLayout {
        Rectangle { horizontal-stretch: 1; }
        Image {
            source: @image-url("../assets/cv-logo.svg");
            width: 150px;
            height: 57px;
            image-fit: contain;
        }
    }
}
