import { ComboBox } from "std-widgets.slint";

// Sound-Modus-Presets (im Gerät speichern/laden). Speicher-Format und
// Protokoll dafür sind noch nicht reverse-engineert (siehe HANDOFF.md,
// "Offene Punkte") – Dropdown ist deshalb rein informativ, ohne Wirkung.
export component SoundModeTab inherits VerticalLayout {
    padding: 16px;
    spacing: 8px;
    alignment: start;

    Text { text: "Sound-Modus"; font-size: 20px; font-weight: 700; }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        ComboBox {
            model: ["Im Gerät"];
            current-index: 0;
            width: 200px;
        }
    }

    Text {
        wrap: word-wrap;
        text: "Presets werden im Original auf dem Gerät gespeichert/geladen (Speichern-/Zurücksetzen-Icons). Das Speicherformat ist noch nicht reverse-engineert.";
    }
}
