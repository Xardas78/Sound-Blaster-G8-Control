import { Button, Switch, Palette } from "std-widgets.slint";

// Entspricht der "Einstellungen"-Seite im Original, aber ohne die
// Gerät/Anwendung-Unterreiter des Originals – auf Wunsch flach in einem
// Reiter zusammengefasst. Energieeinsparung und Logo-LED sind
// implementiert (special::setting_id, siehe main.rs). Gerät zurücksetzen
// ist implementiert und live bestätigt (siehe HANDOFF.md Abschnitt 5a).
// Firmware-Update-*Flash* bleibt bewusst NICHT implementiert (Bricking-
// Risiko), der Versions-*Check* dagegen schon (reiner HTTP-GET, kein
// USB-Risiko) – bei vorhandenem Update wird auf die Windows-Software
// verwiesen. Dark Mode ist reiner UI-Zustand (Slint-Standard-Widgets
// über die eingebaute Palette-Umschaltung), braucht keine Rust-Anbindung.
// Volume Sync/Hintergrunddienst wurden entfernt: PipeWire spiegelt die
// G8-Hardware-Lautstärke bereits von selbst, beide Features waren
// dadurch wirkungslos (siehe HANDOFF.md Abschnitt 7, Nachtrag 2).
export component SettingsTab inherits HorizontalLayout {
    in property <bool> device-connected: false;
    in property <string> serial-number: "";
    in property <string> firmware-version: "";
    in property <bool> firmware-update-available: false;
    in property <bool> firmware-check-failed: false;
    in property <string> firmware-latest-version: "";
    // Rust setzt das kurz auf true, nachdem firmware-version/
    // -update-available/-latest-version aktuell sind, um den
    // Ergebnis-Dialog zu öffnen (siehe changed-Handler unten).
    in-out property <bool> show-firmware-result: false;

    in-out property <bool> power-saving-on: false;
    in-out property <bool> logo-led-on: false;
    in-out property <bool> dark-mode-on: false;
    in-out property <bool> autostart-on: false;
    // 0 = Schließen (Programm beenden), 1 = In den Tray minimieren
    in-out property <int> close-behavior: 0;
    // Von Rust beim Start gesetzt (CARGO_PKG_VERSION, siehe main.rs).
    in property <string> app-version: "";

    callback reset-clicked();
    callback firmware-check-clicked();
    callback power-saving-toggled(bool);
    callback logo-led-toggled(bool);
    callback autostart-toggled(bool);
    callback close-behavior-changed(int);
    callback dark-mode-toggled(bool);

    padding: 16px;
    spacing: 48px;
    alignment: start;

    changed show-firmware-result => {
        if show-firmware-result {
            firmware-result-popup.show();
            show-firmware-result = false;
        }
    }

    firmware-result-popup := PopupWindow {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        Rectangle {
            background: #00000066;

            Rectangle {
                width: 380px;
                height: firmware-update-available ? 220px : 160px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.color-scheme == ColorScheme.dark ? #3a3c3f : white;
                border-radius: 8px;
                border-width: 1px;
                border-color: #cccccc;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000055;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: firmware-check-failed ? @tr("Prüfung fehlgeschlagen") : firmware-update-available ? @tr("Update verfügbar") : @tr("Keine neue Firmware");
                        font-weight: 700;
                        font-size: 17px;
                    }
                    Text {
                        wrap: word-wrap;
                        text: firmware-check-failed
                            ? @tr("Der Update-Server war nicht erreichbar (keine Internetverbindung?). Bitte später erneut versuchen.")
                            : firmware-update-available
                            ? @tr("Eine neuere Firmware ({}) ist verfügbar. Firmware-Updates werden von dieser App nicht unterstützt – bitte dafür die offizielle Creative-Software unter Windows verwenden.", firmware-latest-version)
                            : @tr("Es ist keine neuere Firmware verfügbar.");
                        font-size: 14px;
                        color: gray;
                    }

                    Rectangle { height: 4px; }

                    HorizontalLayout {
                        alignment: end;
                        Button { text: @tr("OK"); clicked => { firmware-result-popup.close(); } }
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: 12px;
        alignment: start;
        Text { text: "Sound Blaster G8"; font-weight: 700; }
        Text { text: device-connected ? @tr("Verbunden (USB 041e:329b)") : @tr("Nicht verbunden"); color: gray; }
        if device-connected && serial-number != "": Text { text: @tr("S/N: {}", serial-number); font-size: 12px; color: gray; }

        Rectangle { height: 16px; }

        Button { text: @tr("Gerät zurücksetzen"); clicked => { reset-clicked(); } }
        Button { text: @tr("Nach Firmware-Update suchen"); clicked => { firmware-check-clicked(); } }
        if firmware-version != "": Text { text: @tr("Firmware: {}", firmware-version); font-size: 12px; color: gray; }

        Rectangle { height: 8px; }

        Text { text: @tr("Version {}", app-version); font-size: 12px; color: gray; }
    }

    VerticalLayout {
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            Switch { checked: power-saving-on; toggled => { power-saving-on = self.checked; power-saving-toggled(self.checked); } }
            Text { text: @tr("Energieeinsparung"); font-weight: 600; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 8px;
            Switch { checked: logo-led-on; toggled => { logo-led-on = self.checked; logo-led-toggled(self.checked); } }
            Text { text: @tr("Sound Blaster Logo LED"); font-weight: 600; vertical-alignment: center; }
        }
    }

    // Ehemals "Anwendung"-Unterreiter – jetzt hier mit eingebaut.
    VerticalLayout {
        spacing: 12px;
        alignment: start;
        Text { text: @tr("Anwendung"); font-weight: 700; }
        HorizontalLayout {
            spacing: 8px;
            Switch {
                checked: dark-mode-on;
                toggled => {
                    // Direkt hier setzen (wie in der ursprünglichen
                    // Implementierung), nicht nur über den changed-Handler
                    // in app-window.slint: eine Palette.color-scheme-
                    // Zuweisung als Reaktion auf eine echte Klick-Aktion in
                    // derselben Datei löst zuverlässig ein Neuzeichnen aus,
                    // über einen changed-Handler in einer anderen Datei war
                    // das bei einem Live-Test nicht der Fall (Standard-
                    // Widgets blieben hell, siehe HANDOFF.md 2026-08-24).
                    // Der changed-Handler bleibt zusätzlich bestehen, für
                    // den Start-Wiederherstellungsfall aus main.rs.
                    dark-mode-on = self.checked;
                    Palette.color-scheme = self.checked ? ColorScheme.dark : ColorScheme.light;
                    dark-mode-toggled(self.checked);
                }
            }
            Text { text: @tr("Dark Mode"); font-weight: 600; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 8px;
            Switch {
                checked: autostart-on;
                toggled => { autostart-on = self.checked; autostart-toggled(self.checked); }
            }
            Text { text: @tr("Mit dem System starten"); font-weight: 600; vertical-alignment: center; }
        }

        Text { text: @tr("Beim Schließen"); font-weight: 600; }
        // Bewusst OHNE feste width: die Breite ergibt sich aus dem Inhalt
        // der beiden Segmente (Text + Innenabstand), damit längere
        // Übersetzungen (z.B. Französisch) nicht abgeschnitten werden statt
        // die Box einfach breiter zu machen.
        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: #e0e0e0;
            clip: true;

            HorizontalLayout {
                Rectangle {
                    background: close-behavior == 0 ? #3d7fd9 : transparent;
                    TouchArea {
                        clicked => { close-behavior = 0; close-behavior-changed(0); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: @tr("Schließen");
                            color: close-behavior == 0 ? white : #333333;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    background: close-behavior == 1 ? #3d7fd9 : transparent;
                    TouchArea {
                        clicked => { close-behavior = 1; close-behavior-changed(1); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: @tr("In den Tray minimieren");
                            font-size: 13px;
                            color: close-behavior == 1 ? white : #333333;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Ersetzt den früheren "Lautstärke-Hintergrunddienst"-Schalter:
        // das Feature ist überflüssig, PipeWire hält Gerät- und PC-
        // Lautstärke bereits von selbst synchron, auch komplett ohne
        // laufende App (siehe HANDOFF.md Abschnitt 7, Nachtrag 2).
        VerticalLayout {
            Text { text: @tr("Lautstärke-Synchronisierung"); font-weight: 600; }
            Text {
                wrap: word-wrap;
                width: 260px;
                text: @tr("Wird nicht benötigt: dein System hält Gerät- und PC-Lautstärke bereits automatisch synchron, auch wenn diese App nicht läuft.");
                color: gray;
            }
        }
    }
}
