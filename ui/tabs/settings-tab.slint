import { Button, Switch, Palette } from "std-widgets.slint";

// Entspricht der "Einstellungen"-Seite im Original, aber ohne die
// Gerät/Anwendung-Unterreiter des Originals – auf Wunsch flach in einem
// Reiter zusammengefasst. Reset ist über den proprietären Kanal noch
// nicht reverse-engineert (kein Capture vorhanden, Risiko eines
// Bricking) – der Button ist vorbereitet, löst aber noch keinen echten
// Befehl aus, siehe HANDOFF.md. Energieeinsparung und Logo-LED sind
// implementiert (special::setting_id, siehe main.rs).
// Firmware-Update bewusst NICHT implementiert: Update-Ablauf/Netzwerk-
// Traffic der Original-Software nicht reverse-engineert, zu riskant, um
// zu raten – siehe HANDOFF.md. Bei Bedarf unter Windows aktualisieren.
// Volume Sync IST implementiert (siehe main.rs): spiegelt den
// Lautstärkeknopf-Prozentwert live auf die PipeWire-Sink-Lautstärke.
// Dark Mode ist reiner UI-Zustand (Slint-Standard-Widgets über die
// eingebaute Palette-Umschaltung), braucht keine Rust-Anbindung.
export component SettingsTab inherits HorizontalLayout {
    in property <bool> device-connected: false;
    // Live vom Poll-Thread in main.rs gefüllt (derselbe Wert, der auch den
    // Fußleisten-Regler mitlaufen lässt) – damit kann der Bestätigungs-
    // Dialog unten die tatsächliche Reglerposition anzeigen, statt den
    // Nutzer blind auf 50% stellen zu lassen.
    in property <float> footer-speaker-level: 49;

    // Default false (erster Start ohne gespeicherte Einstellungen). Rust
    // setzt das beim Programmstart auf den zuletzt gespeicherten Wert
    // (siehe persist.rs/main.rs) – dabei OHNE den Bestätigungsdialog
    // unten (der ist nur für bewusstes manuelles Umschalten mitten in
    // der Nutzung gedacht, main.rs sichert den Start stattdessen per
    // "erst stumm, dann Reglerstand" ab).
    in-out property <bool> volume-sync-on: false;
    in-out property <bool> power-saving-on: false;
    in-out property <bool> logo-led-on: false;
    in-out property <bool> dark-mode-on: false;
    in-out property <bool> autostart-on: false;
    // 0 = Schließen (Programm beenden), 1 = In den Tray minimieren
    in-out property <int> close-behavior: 0;
    // Hintergrunddienst (systemd --user): hält die Lautstärke-Kopplung
    // (Knopf↔PipeWire) auch am Laufen, wenn die App komplett beendet
    // wird (nicht nur in den Tray minimiert) – siehe daemon.rs.
    in-out property <bool> daemon-on: false;

    callback reset-clicked();
    callback volume-sync-toggled(bool);
    callback power-saving-toggled(bool);
    callback logo-led-toggled(bool);
    callback autostart-toggled(bool);
    callback close-behavior-changed(int);
    callback dark-mode-toggled(bool);
    callback daemon-toggled(bool);

    padding: 16px;
    spacing: 48px;
    alignment: start;

    VerticalLayout {
        spacing: 12px;
        alignment: start;
        Text { text: "Sound Blaster G8"; font-weight: 700; }
        Text { text: device-connected ? "Verbunden (USB 041e:329b)" : "Nicht verbunden"; color: gray; }
        Button { text: "Gerät zurücksetzen"; clicked => { reset-clicked(); } }
    }

    VerticalLayout {
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            Switch {
                checked: volume-sync-on;
                toggled => {
                    if self.checked {
                        // Nicht sofort aktivieren: erst per Dialog
                        // bestätigen lassen, dass der Regler auf 50%
                        // steht (verhindert einen Lautstärke-Sprung).
                        volume-sync-confirm.show();
                    } else {
                        volume-sync-on = false;
                        volume-sync-toggled(false);
                    }
                }
            }
            VerticalLayout {
                Text { text: "Volume Sync"; font-weight: 600; }
                Text {
                    wrap: word-wrap;
                    width: 260px;
                    text: "Der Lautstärkeknopf steuert Geräte- und PC-Lautstärke gemeinsam.";
                    color: gray;
                }
            }
        }
        volume-sync-confirm := PopupWindow {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;

            Rectangle {
                background: #00000066;

                Rectangle {
                    width: 380px;
                    height: 240px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: Palette.color-scheme == ColorScheme.dark ? #3a3c3f : white;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #cccccc;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000055;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        alignment: start;

                        Text { text: "Volume Sync aktivieren"; font-weight: 700; font-size: 17px; }
                        Text {
                            wrap: word-wrap;
                            text: "Stelle den Lautstärkeknopf am Gerät auf 50%, bevor du bestätigst – sonst springt die PC-Lautstärke sofort auf den aktuellen Reglerstand.";
                            font-size: 14px;
                            color: gray;
                        }
                        Text {
                            text: "Aktueller Reglerstand: " + round(footer-speaker-level) + "%";
                            font-weight: 700;
                            color: abs(footer-speaker-level - 50) < 3 ? #2ecc71 : #e07b2a;
                        }

                        Rectangle { height: 4px; }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: end;
                            Button { text: "Abbrechen"; clicked => { volume-sync-confirm.close(); } }
                            Button {
                                text: "OK, aktivieren";
                                clicked => {
                                    volume-sync-on = true;
                                    volume-sync-toggled(true);
                                    volume-sync-confirm.close();
                                }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Switch { checked: power-saving-on; toggled => { power-saving-on = self.checked; power-saving-toggled(self.checked); } }
            Text { text: "Energieeinsparung"; font-weight: 600; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 8px;
            Switch { checked: logo-led-on; toggled => { logo-led-on = self.checked; logo-led-toggled(self.checked); } }
            Text { text: "Sound Blaster Logo LED"; font-weight: 600; vertical-alignment: center; }
        }
    }

    // Ehemals "Anwendung"-Unterreiter – jetzt hier mit eingebaut.
    VerticalLayout {
        spacing: 12px;
        alignment: start;
        Text { text: "Anwendung"; font-weight: 700; }
        HorizontalLayout {
            spacing: 8px;
            Switch {
                checked: dark-mode-on;
                toggled => {
                    // Palette.color-scheme wird zentral in app-window.slint
                    // gesetzt (changed dark-mode-on => {...}), damit dasselbe
                    // sowohl bei Klick hier als auch beim Wiederherstellen
                    // gespeicherter Einstellungen von Rust greift.
                    dark-mode-on = self.checked;
                    dark-mode-toggled(self.checked);
                }
            }
            Text { text: "Dark Mode"; font-weight: 600; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 8px;
            Switch {
                checked: autostart-on;
                toggled => { autostart-on = self.checked; autostart-toggled(self.checked); }
            }
            Text { text: "Mit dem System starten"; font-weight: 600; vertical-alignment: center; }
        }

        Text { text: "Beim Schließen"; font-weight: 600; }
        Rectangle {
            width: 260px;
            height: 32px;
            border-radius: 6px;
            background: #e0e0e0;
            clip: true;

            HorizontalLayout {
                Rectangle {
                    background: close-behavior == 0 ? #3d7fd9 : transparent;
                    TouchArea {
                        clicked => { close-behavior = 0; close-behavior-changed(0); }
                    }
                    Text {
                        text: "Schließen";
                        color: close-behavior == 0 ? white : #333333;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    background: close-behavior == 1 ? #3d7fd9 : transparent;
                    TouchArea {
                        clicked => { close-behavior = 1; close-behavior-changed(1); }
                    }
                    Text {
                        text: "In den Tray minimieren";
                        font-size: 13px;
                        color: close-behavior == 1 ? white : #333333;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Switch {
                checked: daemon-on;
                toggled => { daemon-on = self.checked; daemon-toggled(self.checked); }
            }
            VerticalLayout {
                Text { text: "Lautstärke-Hintergrunddienst"; font-weight: 600; }
                Text {
                    wrap: word-wrap;
                    width: 260px;
                    text: "Hält den Lautstärkeknopf auch dann mit der PC-Lautstärke verbunden, wenn die App komplett beendet ist (nicht nur im Tray).";
                    color: gray;
                }
            }
        }
    }
}
