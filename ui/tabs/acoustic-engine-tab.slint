import { EffectSlider, CompactSwitch } from "../effect-slider.slint";
import { Slider, Palette } from "std-widgets.slint";

// Entspricht der "Acoustic Engine"-Seite im Original (siehe Screenshot im
// Projektordner). Kopfhörer/Lautsprecher-Umschalter oben ist rein
// UI-seitig – aus den Captures geht nicht hervor, ob/wie das Original
// dafür zwei getrennte Wertesätze im Gerät hält, deshalb wirkt sich der
// Umschalter hier nicht auf die Werte aus.
//
// WICHTIG (per USB-Capture "acoustic engine.pcapng" bestätigt): die
// Pegel-Parameter (Surround/Crystalizer/Bass/Smart-Volume/Dialog+-Level)
// erwarten einen Float zwischen 0.0 und 1.0, NICHT den rohen 0-100-
// Slider-Wert! Das war vorher ein Bug (v statt v/100 gesendet) – hier
// gefixt. Toggle-Parameter (0.0/0.5/1.0 o.ä.) und Smart-Volume-Modus
// (0.0=Normal/1.0=Laut/2.0=Nacht) sind laut Capture unverändert korrekt.
export component AcousticEngineTab inherits VerticalLayout {
    // Gemeinsamer Zustand mit der Wiedergabe-Seite, AppWindow hält den
    // eigentlichen Wert (siehe app-window.slint) – hier nur Anzeige +
    // Klick-Weiterleitung, kein lokaler Zustand mehr.
    in property <int> output-target: 0; // 0=Kopfhörer, 1=Lautsprecher

    in-out property <bool> surround-on: true;
    in-out property <float> surround-level: 48;

    in-out property <bool> crystalizer-on: true;
    in-out property <float> crystalizer-level: 52;

    in-out property <bool> bass-on: true;
    in-out property <float> bass-level: 52;

    in-out property <bool> smart-volume-on: true;
    in-out property <float> smart-volume-level: 52;
    in-out property <int> smart-volume-mode: 0; // 0=Normal, 1=Laut, 2=Nacht

    in-out property <bool> dialog-plus-on: true;
    in-out property <float> dialog-plus-level: 56;

    // param-id, value – Rust ordnet über acoustic_engine::* Konstanten zu
    callback param-changed(int, float);
    // 0=Kopfhörer, 1=Lautsprecher – schaltet den virtuellen HRTF-Surround
    // (siehe virtual_surround.rs) ein bzw. aus.
    callback output-target-changed(int);

    padding: 16px;
    spacing: 16px;
    alignment: start;

    // Kopfhörer/Lautsprecher-Segmentumschalter, mittig über dem Inhalt
    // (per Wireframe-Koordinaten: Umschalter zentriert über den 5 Spalten,
    // nicht linksbündig).
    HorizontalLayout {
        alignment: center;
        // Bewusst OHNE feste width, siehe settings-tab.slint ("Beim
        // Schließen") -- Breite ergibt sich aus dem Inhalt.
        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: #e0e0e0;
            clip: true;

            HorizontalLayout {
                Rectangle {
                    background: output-target == 0 ? #3d7fd9 : transparent;
                    TouchArea { clicked => { output-target-changed(0); } }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: @tr("Kopfhörer");
                            color: output-target == 0 ? white : #333333;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    background: output-target == 1 ? #3d7fd9 : transparent;
                    TouchArea { clicked => { output-target-changed(1); } }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: @tr("Lautsprecher");
                            color: output-target == 1 ? white : #333333;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
    Text {
        text: output-target == 0
            ? @tr("Kopfhörer aktiviert virtuellen HRTF-Surround (SBX) – PipeWire startet dafür kurz neu.")
            : @tr("Lautsprecher gibt direkt über die G8-Hardware aus, ohne virtuellen Surround.");
        horizontal-alignment: center;
        font-size: 13px;
        color: gray;
    }

    // Fünf gleich breite/hohe Karten (wie die Mixer-Tab-Karten, siehe
    // mixer-tab.slint) statt loser Spalten – auf Nutzerwunsch: Breite an
    // der kurzen Bass-Beschreibung orientiert statt an der längsten
    // (Crystalizer wickelt dadurch auf mehr Zeilen um, das ist gewollt).
    // `alignment: space-between` statt fester `spacing`, damit die erste
    // Karte links und die letzte rechts bündig sitzen und der Zwischenraum
    // automatisch gleichmäßig verteilt wird – kein manuelles Verschieben
    // des rechten Rands nötig. Feste `height` auf allen Karten, da die
    // Beschreibungstexte unterschiedlich viele Zeilen brauchen.
    HorizontalLayout {
        alignment: space-between;

        Rectangle {
            width: 240px;
            border-radius: 8px;
            background: Palette.color-scheme == ColorScheme.dark ? #2C2C2C : #f0f0f0;
            EffectSlider {
                label: "Surround";
                description: @tr("Erzeugt ein beispielloses Maß an Audio-Realismus, indem virtuelle Lautsprecher um Sie herum erzeugt werden.");
                effect-enabled <=> surround-on;
                value: surround-level;
                toggled(on) => { param-changed(0, on ? 1.0 : 0.0); }
                value-changed(v) => { surround-level = v; param-changed(1, v / 100); }
            }
        }
        Rectangle {
            width: 240px;
            border-radius: 8px;
            background: Palette.color-scheme == ColorScheme.dark ? #2C2C2C : #f0f0f0;
            EffectSlider {
                label: "Crystalizer";
                description: @tr("Stellt sicher, dass Musik so klingt, wie der Künstler ursprünglich beabsichtigt hat, indem man jedes Audio-Detail hören kann.");
                effect-enabled <=> crystalizer-on;
                value: crystalizer-level;
                toggled(on) => { param-changed(7, on ? 1.0 : 0.0); }
                value-changed(v) => { crystalizer-level = v; param-changed(8, v / 100); }
            }
        }
        Rectangle {
            width: 240px;
            border-radius: 8px;
            background: Palette.color-scheme == ColorScheme.dark ? #2C2C2C : #f0f0f0;
            EffectSlider {
                label: "Bass";
                description: @tr("Deutlich verbessert das Klangerlebnis durch die bessere Wiedergabe der tiefen Töne.");
                effect-enabled <=> bass-on;
                value: bass-level;
                toggled(on) => { param-changed(24, on ? 1.0 : 0.0); }
                value-changed(v) => { bass-level = v; param-changed(25, v / 100); }
            }
        }

        // Smart Volume: eigener Block statt EffectSlider, weil zusätzlich
        // zum Ein/Aus-Schalter noch eine Nacht/Normal/Laut-Leiste darunter
        // sitzt (SMART_VOLUME_MODE, Param 0x06 – per Capture bestätigt:
        // 0.0=Normal, 1.0=Laut, 2.0=Nacht). Reihenfolge/Position exakt
        // nach Wireframe-Koordinaten: Leiste kommt NACH dem Schalter,
        // nicht daneben.
        Rectangle {
            width: 240px;
            border-radius: 8px;
            background: Palette.color-scheme == ColorScheme.dark ? #2C2C2C : #f0f0f0;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                alignment: start;

                Text { text: "Smart Volume"; horizontal-alignment: center; font-weight: 600; }
                Text { text: round(smart-volume-level); horizontal-alignment: center; }

                Slider {
                    orientation: vertical;
                    minimum: 0; maximum: 100;
                    value: smart-volume-level;
                    enabled: smart-volume-on;
                    height: 300px;
                    changed(v) => { smart-volume-level = v; param-changed(5, v / 100); }
                }

                HorizontalLayout {
                    alignment: center;
                    CompactSwitch {
                        checked <=> smart-volume-on;
                        toggled(on) => { param-changed(4, on ? 1.0 : 0.0); }
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: #e0e0e0;
                    clip: true;
                    opacity: smart-volume-on ? 1.0 : 0.5;

                    HorizontalLayout {
                        Rectangle {
                            background: smart-volume-mode == 2 ? #3d7fd9 : transparent;
                            TouchArea { enabled: smart-volume-on; clicked => { smart-volume-mode = 2; param-changed(6, 2.0); } }
                            Text {
                                text: @tr("Nacht");
                                font-size: 13px;
                                color: smart-volume-mode == 2 ? white : #333333;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            background: smart-volume-mode == 0 ? #3d7fd9 : transparent;
                            TouchArea { enabled: smart-volume-on; clicked => { smart-volume-mode = 0; param-changed(6, 0.0); } }
                            Text {
                                text: @tr("Normal");
                                font-size: 13px;
                                color: smart-volume-mode == 0 ? white : #333333;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            background: smart-volume-mode == 1 ? #3d7fd9 : transparent;
                            TouchArea { enabled: smart-volume-on; clicked => { smart-volume-mode = 1; param-changed(6, 1.0); } }
                            Text {
                                text: @tr("Laut");
                                font-size: 13px;
                                color: smart-volume-mode == 1 ? white : #333333;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: @tr("Intelligenterweise verringert abrupte Lautstärkeänderungen durch automatische Lautstärkeanpassung der Audiowiedergabe.");
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    font-size: 16px;
                    color: gray;
                }
            }
        }

        Rectangle {
            width: 240px;
            border-radius: 8px;
            background: Palette.color-scheme == ColorScheme.dark ? #2C2C2C : #f0f0f0;
            EffectSlider {
                label: "Dialog+";
                description: @tr("Intelligenterweise verstärkt Stimmen in Musik und Filmen für eine deutlich klarere Stimmenwiedergabe.");
                effect-enabled <=> dialog-plus-on;
                value: dialog-plus-level;
                toggled(on) => { param-changed(2, on ? 1.0 : 0.0); }
                value-changed(v) => { dialog-plus-level = v; param-changed(3, v / 100); }
            }
        }
    }

    Text {
        text: "SBX";
        font-size: 22px;
        font-weight: 800;
        font-italic: true;
        color: #999999;
        horizontal-alignment: right;
    }
}
