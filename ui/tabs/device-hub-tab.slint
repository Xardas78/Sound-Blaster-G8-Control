import { TabWidget } from "std-widgets.slint";
import { AcousticEngineTab } from "acoustic-engine-tab.slint";
import { EqualizerTab } from "equalizer-tab.slint";
import { CrystalVoiceTab } from "crystal-voice-tab.slint";
import { ModiDecoderTab } from "misc-tabs.slint";
import { MixerTab } from "mixer-tab.slint";

// Im Original ist "Gerät" der Haupt-Hub: eine Kachel-Übersicht, aus der
// Sound-Modus, Acoustic Engine, Equalizer, CrystalVoice, Direct Mode,
// Scout Mode, Decoder und Mixer als Detailseiten aufgehen (Kachel-Screenshots
// im Projektordner). Wir bilden das flach als zweite Tab-Reihe ab statt
// Kachel-Navigation mit Zurück-Pfeil.
export component DeviceHubTab inherits TabWidget {
    current-index: 0;

    in property <int> output-target: 0;
    // Geteilter Zustand mit dem Fußleisten-Regler (siehe app-window.slint),
    // damit Mixer-Tab und Fußleiste dieselbe Lautsprecher-/Mikrofon-
    // Lautstärke zeigen, statt zwei unabhängige Kopien zu pflegen, die
    // nie voneinander wissen. in-out (nicht in): muss die Zwei-Wege-
    // Bindung bis nach MixerTab durchreichen können.
    in-out property <float> footer-speaker-level: 49;
    in-out property <float> footer-mic-level: 63;

    callback playback-param-changed(int, float);
    callback output-target-changed(int);
    callback recording-param-changed(int, float);
    callback eq-param-changed(int, float);
    callback scout-toggled(bool);
    callback direct-mode-toggled(bool);
    callback decoder-mode-changed(int);
    callback mixer-level-changed(int, float);

    Tab {
        title: "Acoustic Engine";
        AcousticEngineTab {
            output-target: output-target;
            param-changed(id, v) => { playback-param-changed(id, v); }
            output-target-changed(t) => { output-target-changed(t); }
        }
    }
    Tab {
        title: "Equalizer";
        EqualizerTab {
            param-changed(id, v) => { eq-param-changed(id, v); }
        }
    }
    Tab {
        title: "CrystalVoice";
        CrystalVoiceTab {
            param-changed(id, v) => { recording-param-changed(id, v); }
        }
    }
    Tab {
        title: "Modi & Decoder";
        ModiDecoderTab {
            direct-mode-toggled(on) => { direct-mode-toggled(on); }
            scout-toggled(on) => { scout-toggled(on); }
            decoder-mode-changed(m) => { decoder-mode-changed(m); }
        }
    }
    Tab {
        title: "Mixer";
        MixerTab {
            playback-speaker: footer-speaker-level;
            rec-ext-mic: footer-mic-level;
            level-changed(id, v) => { mixer-level-changed(id, v); }
        }
    }
}
