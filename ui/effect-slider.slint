import { Slider, Switch, Palette } from "std-widgets.slint";

// Ein Regler-Block wie in der Acoustic-Engine-/CrystalVoice-Seite des
// Originals: Titel, Zahlenwert, vertikaler Slider, darunter ein Toggle.
export component EffectSlider inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <bool> effect-enabled: true;
    in property <float> value: 50;
    in property <float> minimum: 0;
    in property <float> maximum: 100;

    callback toggled(bool);
    callback value-changed(float);

    spacing: 8px;
    alignment: start;
    width: 230px;

    Text {
        text: label;
        horizontal-alignment: center;
        font-weight: 600;
    }

    Text {
        text: round(value);
        horizontal-alignment: center;
    }

    Slider {
        orientation: vertical;
        minimum: minimum;
        maximum: maximum;
        value: value;
        enabled: effect-enabled;
        height: 300px;
        changed(v) => { value-changed(v); }
    }

    HorizontalLayout {
        alignment: center;
        Switch {
            checked: effect-enabled;
            toggled => { toggled(self.checked); }
        }
    }

    Text {
        text: description;
        wrap: word-wrap;
        horizontal-alignment: center;
        font-size: 16px;
        color: gray;
    }
}

// Kompakte Zeile für den Sound-Modus-Tab: Titel, Schalter, horizontaler
// Slider, Zahlenwert – ein Effekt pro Zeile statt eines eigenen Blocks
// wie EffectSlider oben (siehe Original-Screenshot der "Sound-Modus"-Seite).
export component CompactEffectRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> effect-enabled: true;
    in-out property <float> value: 50;
    in property <float> minimum: 0;
    in property <float> maximum: 100;

    callback toggled(bool);
    callback value-changed(float);

    spacing: 12px;

    Text {
        text: label;
        width: 110px;
        vertical-alignment: center;
    }
    Switch {
        checked: effect-enabled;
        toggled => { toggled(self.checked); }
    }
    Slider {
        minimum: minimum;
        maximum: maximum;
        value: value;
        enabled: effect-enabled;
        horizontal-stretch: 1;
        changed(v) => { value-changed(v); }
    }
    Text {
        text: effect-enabled ? "\{round(value)}" : "Aus";
        width: 32px;
        color: effect-enabled ? Palette.foreground : #999999;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Einfacher Ein/Aus-Regler ohne Slider (z.B. Direct Mode, Scout Mode).
export component EffectToggle inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked: false;

    callback toggled(bool);

    spacing: 8px;

    Switch {
        checked: checked;
        toggled => { toggled(self.checked); }
    }
    Text {
        text: label;
        font-size: 18px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

// Schlanke Zahlen-Eingabe mit Hoch/Runter-Pfeilen für enge Spalten (z. B.
// unter den Equalizer-Slidern). Die eingebaute `SpinBox` aus std-widgets
// hat im Fluent-Style eine feste Mindestbreite von 128px – zu breit für
// 64-74px-Spalten. Diese Komponente hat keine Mindestbreite und passt sich
// der `width`, die man ihr gibt, an. Bedienung nur über die Pfeile (keine
// Texteingabe), das reicht für die vorgesehenen Werte im Bereich -12..12.
export component CompactSpinBox inherits Rectangle {
    in property <int> minimum: -12;
    in property <int> maximum: 12;
    in-out property <int> value: 0;
    in property <bool> enabled: true;

    callback edited(int);

    height: 30px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #cccccc;
    background: enabled ? white : #f0f0f0;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 2px;

        Text {
            text: value;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 12px;
            color: enabled ? #333333 : #999999;
        }

        // Echte gefüllte Dreiecke statt Unicode-Pfeilzeichen (⌃/⌄) – die
        // rendern je nach Font oft viel dünner/kleiner als die Font-Size
        // vermuten lässt und waren dadurch schlecht erkennbar. Jedes
        // Dreieck nimmt die halbe Box-Höhe ein (15px von 30px).
        VerticalLayout {
            width: 18px;
            TouchArea {
                height: 15px;
                enabled: root.enabled && value < maximum;
                clicked => { value += 1; edited(value); }
                Path {
                    x: 4px;
                    y: 4.5px;
                    width: 10px;
                    height: 6px;
                    viewbox-width: 10;
                    viewbox-height: 6;
                    fill: #555555;
                    opacity: root.enabled && value < maximum ? 1.0 : 0.4;
                    MoveTo { x: 5; y: 0; }
                    LineTo { x: 10; y: 6; }
                    LineTo { x: 0; y: 6; }
                    Close { }
                }
            }
            TouchArea {
                height: 15px;
                enabled: root.enabled && value > minimum;
                clicked => { value -= 1; edited(value); }
                Path {
                    x: 4px;
                    y: 4.5px;
                    width: 10px;
                    height: 6px;
                    viewbox-width: 10;
                    viewbox-height: 6;
                    fill: #555555;
                    opacity: root.enabled && value > minimum ? 1.0 : 0.4;
                    MoveTo { x: 0; y: 0; }
                    LineTo { x: 10; y: 0; }
                    LineTo { x: 5; y: 6; }
                    Close { }
                }
            }
        }
    }
}

// Eigene Dropdown-Auswahl statt std-widgets-ComboBox: die hat wie
// SpinBox kein `font-size`, um die Schrift anzupassen (Fluent-Style
// bindet die interne Text-Schriftgröße fest). Popup über den Slint-
// eingebauten PopupWindow-Baustein.
export component CompactComboBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    in property <length> item-font-size: 14px;

    callback selected(int);

    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #cccccc;
    background: enabled ? white : #f0f0f0;

    TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 4px;

        Text {
            text: model[current-index];
            font-size: item-font-size;
            color: enabled ? #333333 : #999999;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: "⌄";
            font-size: item-font-size;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: #666666;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        height: model.length * 26px + 4px;

        Rectangle {
            background: white;
            border-width: 1px;
            border-color: #cccccc;

            VerticalLayout {
                padding: 2px;
                for entry[i] in root.model: Rectangle {
                    height: 26px;
                    background: i == current-index ? #e8f0fb : transparent;
                    TouchArea {
                        clicked => { current-index = i; selected(i); }
                    }
                    Text {
                        text: entry;
                        font-size: item-font-size;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        x: 8px;
                    }
                }
            }
        }
    }
}
