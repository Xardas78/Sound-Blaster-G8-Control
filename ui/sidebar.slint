import { Slider } from "std-widgets.slint";

// Feste linke Spalte, immer sichtbar unabhängig vom aktiven Tab (siehe
// app-window.slint) – ersetzt die alte QuickControlsBar-Fußleiste unter
// dem Tab-Inhalt: dort verschwanden die Regler bei hohem Tab-Inhalt
// (Acoustic-Engine-Karten) unterhalb des sichtbaren Fensterbereichs.
// HP/SPK-Icons: eigene Vektorgrafik (assets/icon-hp.svg, icon-spk.svg,
// aus HP&SPK.svg extrahiert), reine Konturen ohne Fill, damit
// Image.colorize sie je nach Zustand einfärben kann.
export component Sidebar inherits VerticalLayout {
    in-out property <int> output-target: 0; // 0=Kopfhörer, 1=Lautsprecher
    in-out property <float> speaker-level: 49;
    in-out property <float> mic-level: 63;
    in-out property <bool> speaker-muted: false;
    in-out property <bool> mic-muted: false;

    callback output-target-changed(int);
    // entity-id (0=Lautsprecher, 6=External Mic – siehe mixer.rs::CONTROLS), Prozent
    callback level-changed(int, float);
    // entity-id, gemutet
    callback mute-changed(int, bool);

    width: 170px;
    padding: 16px;
    spacing: 16px;
    alignment: start;

    Rectangle {
        height: 40px;
        border-radius: 6px;
        background: #e0e0e0;
        clip: true;

        HorizontalLayout {
            Rectangle {
                background: output-target == 0 ? #3d7fd9 : transparent;
                TouchArea { clicked => { output-target-changed(0); } }
                Image {
                    source: @image-url("assets/icon-hp.svg");
                    colorize: output-target == 0 ? white : #333333;
                    width: 22px;
                    height: 22px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            Rectangle {
                background: output-target == 1 ? #3d7fd9 : transparent;
                TouchArea { clicked => { output-target-changed(1); } }
                Image {
                    source: @image-url("assets/icon-spk.svg");
                    colorize: output-target == 1 ? white : #333333;
                    width: 22px;
                    height: 22px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }

    // Etwas tiefer als die Slider im Acoustic-Engine-Tab, auf Nutzerwunsch.
    Rectangle { height: 100px; }

    HorizontalLayout {
        alignment: center;
        spacing: 24px;

        VerticalLayout {
            alignment: start;
            spacing: 8px;

            TouchArea {
                width: 36px;
                height: 36px;
                clicked => { speaker-muted = !speaker-muted; mute-changed(0, speaker-muted); }
                Text { text: "🔊"; font-size: 26px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                if speaker-muted: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    stroke: #e74c3c;
                    stroke-width: 2px;
                    MoveTo { x: 4; y: 20; }
                    LineTo { x: 20; y: 4; }
                }
            }
            Slider {
                orientation: vertical;
                minimum: 0; maximum: 100;
                value <=> speaker-level;
                height: 300px;
                changed(v) => { level-changed(0, v); }
            }
            // Feste Breite: ohne die verschiebt sich die andere Spalte beim
            // Ziehen (z.B. "0%" vs. "100%" sind unterschiedlich breit).
            Text { text: round(speaker-level) + "%"; width: 40px; horizontal-alignment: center; }
        }

        VerticalLayout {
            alignment: start;
            spacing: 8px;

            TouchArea {
                width: 36px;
                height: 36px;
                clicked => { mic-muted = !mic-muted; mute-changed(6, mic-muted); }
                // Eigenes Mikrofon-Symbol statt Emoji: das 🎤-Zeichen fehlt in
                // der verfügbaren Schriftart komplett (rendert leer), einfache
                // Kapsel+Ständer-Form ist schriftunabhängig. Maße 1.5x
                // gegenüber der ursprünglichen 24px-Box (auf 36px skaliert).
                Rectangle {
                    width: 12px;
                    height: 18px;
                    border-radius: 6px;
                    background: #333333;
                    x: (parent.width - self.width) / 2;
                    y: 4.5px;
                }
                Rectangle {
                    width: 3px;
                    height: 9px;
                    background: #333333;
                    x: (parent.width - self.width) / 2;
                    y: 24px;
                }
                Rectangle {
                    width: 15px;
                    height: 3px;
                    background: #333333;
                    x: (parent.width - self.width) / 2;
                    y: 31.5px;
                }
                if mic-muted: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    stroke: #e74c3c;
                    stroke-width: 2px;
                    MoveTo { x: 4; y: 20; }
                    LineTo { x: 20; y: 4; }
                }
            }
            Slider {
                orientation: vertical;
                minimum: 0; maximum: 100;
                value <=> mic-level;
                height: 300px;
                changed(v) => { level-changed(6, v); }
            }
            Text { text: round(mic-level) + "%"; width: 40px; horizontal-alignment: center; }
        }
    }
}
