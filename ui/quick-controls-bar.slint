import { Slider } from "std-widgets.slint";

// Im Original unten links in der Navigationsleiste fix sichtbar, auf jeder
// Seite gleich: Ausgabe-Route-Umschalter + Lautstärke-/Mikro-Schnellregler.
// Wir bilden das als Fußleiste unter dem TabWidget ab (horizontale statt
// linke Navigation, siehe app-window.slint). Icons sind klickbar zum
// Stummschalten (echte ALSA-"...Switch"-Controls, siehe mixer.rs), zeigen
// im gemuteten Zustand einen roten Strich quer über dem Symbol.
export component QuickControlsBar inherits HorizontalLayout {
    in-out property <float> speaker-level: 49;
    in-out property <float> mic-level: 63;
    in-out property <bool> speaker-muted: false;
    in-out property <bool> mic-muted: false;

    // entity-id (0=Lautsprecher, 6=External Mic – siehe mixer.rs::CONTROLS), Prozent
    callback level-changed(int, float);
    // entity-id, gemutet
    callback mute-changed(int, bool);

    padding: 12px;
    spacing: 16px;

    TouchArea {
        width: 24px;
        height: 24px;
        clicked => { speaker-muted = !speaker-muted; mute-changed(0, speaker-muted); }
        Text { text: "🔊"; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
        if speaker-muted: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 24;
            viewbox-height: 24;
            stroke: #e74c3c;
            stroke-width: 2px;
            MoveTo { x: 4; y: 20; }
            LineTo { x: 20; y: 4; }
        }
    }
    Slider {
        minimum: 0; maximum: 100;
        value: speaker-level;
        changed(v) => { speaker-level = v; level-changed(0, v); }
    }
    Text { text: round(speaker-level) + "%"; width: 40px; vertical-alignment: center; }

    TouchArea {
        width: 24px;
        height: 24px;
        clicked => { mic-muted = !mic-muted; mute-changed(6, mic-muted); }
        // Eigenes Mikrofon-Symbol statt Emoji: das 🎤-Zeichen fehlt in der
        // verfügbaren Schriftart komplett (rendert leer), einfache
        // Kapsel+Ständer-Form ist schriftunabhängig.
        Rectangle {
            width: 8px;
            height: 12px;
            border-radius: 4px;
            background: #333333;
            x: (parent.width - self.width) / 2;
            y: 3px;
        }
        Rectangle {
            width: 2px;
            height: 6px;
            background: #333333;
            x: (parent.width - self.width) / 2;
            y: 16px;
        }
        Rectangle {
            width: 10px;
            height: 2px;
            background: #333333;
            x: (parent.width - self.width) / 2;
            y: 21px;
        }
        if mic-muted: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 24;
            viewbox-height: 24;
            stroke: #e74c3c;
            stroke-width: 2px;
            MoveTo { x: 4; y: 20; }
            LineTo { x: 20; y: 4; }
        }
    }
    Slider {
        minimum: 0; maximum: 100;
        value: mic-level;
        changed(v) => { mic-level = v; level-changed(6, v); }
    }
    Text { text: round(mic-level) + "%"; width: 40px; vertical-alignment: center; }
}
