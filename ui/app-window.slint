import { TabWidget, VerticalBox } from "std-widgets.slint";
import { DeviceHubTab } from "tabs/device-hub-tab.slint";
import { PlaybackSettingsTab } from "tabs/playback-settings-tab.slint";
import { RecordingSettingsTab } from "tabs/recording-settings-tab.slint";
import { SettingsTab } from "tabs/settings-tab.slint";
import { QuickControlsBar } from "quick-controls-bar.slint";

// Top-Level-Struktur folgt jetzt 1:1 dem Original (siehe Screenshots im
// Projektordner): Gerät ist der Haupt-Hub für alle Effekte/Mixer, Wiedergabe
// und Aufnahme sind reine Geräte-/Qualitätsauswahl, Einstellungen hat
// Unterreiter Gerät/Anwendung.
export component AppWindow inherits Window {
    title: "Sound Blaster G8 Control";
    width: 1350px;
    height: 820px;

    // Von Rust beim Start gesetzt (device.rs / G8Device::open()).
    in-out property <bool> device-connected: false;
    in-out property <string> device-status: "Suche Gerät …";

    // Rust bindet sich an diese Callbacks; siehe protocol.rs für die
    // Report-Builder-Funktionen pro Namespace.
    callback playback-param-changed(int, float);
    callback recording-param-changed(int, float);
    callback eq-param-changed(int, float);
    callback scout-toggled(bool);
    callback direct-mode-toggled(bool);
    callback decoder-mode-changed(int);
    callback mixer-level-changed(int, float);
    callback capture-source-changed(int);
    callback reset-clicked();
    callback volume-sync-toggled(bool);
    callback power-saving-toggled(bool);
    callback logo-led-toggled(bool);

    VerticalLayout {
        TabWidget {
            Tab {
                title: "Gerät";
                DeviceHubTab {
                    playback-param-changed(id, v) => { playback-param-changed(id, v); }
                    recording-param-changed(id, v) => { recording-param-changed(id, v); }
                    eq-param-changed(id, v) => { eq-param-changed(id, v); }
                    scout-toggled(on) => { scout-toggled(on); }
                    direct-mode-toggled(on) => { direct-mode-toggled(on); }
                    decoder-mode-changed(m) => { decoder-mode-changed(m); }
                    mixer-level-changed(id, v) => { mixer-level-changed(id, v); }
                }
            }
            Tab {
                title: "Wiedergabe";
                PlaybackSettingsTab { }
            }
            Tab {
                title: "Aufnahme";
                RecordingSettingsTab {
                    source-selected(i) => { capture-source-changed(i); }
                }
            }
            Tab {
                title: "Einstellungen";
                SettingsTab {
                    device-connected: device-connected;
                    reset-clicked => { reset-clicked(); }
                    volume-sync-toggled(on) => { volume-sync-toggled(on); }
                    power-saving-toggled(on) => { power-saving-toggled(on); }
                    logo-led-toggled(on) => { logo-led-toggled(on); }
                }
            }
        }

        QuickControlsBar {
            level-changed(id, v) => { mixer-level-changed(id, v); }
        }

        if !device-connected: VerticalLayout {
            padding: 8px;
            Text {
                horizontal-alignment: center;
                color: #e74c3c;
                text: device-status;
            }
        }
    }
}
