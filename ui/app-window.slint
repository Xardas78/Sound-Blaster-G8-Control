import { TabWidget, VerticalBox } from "std-widgets.slint";
import { AcousticEngineTab } from "tabs/acoustic-engine-tab.slint";
import { CrystalVoiceTab } from "tabs/crystal-voice-tab.slint";
import { EqualizerTab } from "tabs/equalizer-tab.slint";
import { ScoutModeTab, DirectModeTab, DecoderTab } from "tabs/misc-tabs.slint";
import { MixerTab } from "tabs/mixer-tab.slint";

export component AppWindow inherits Window {
    title: "Sound Blaster G8 Control";
    width: 900px;
    height: 600px;

    // Von Rust beim Start gesetzt (device.rs / G8Device::open()).
    in-out property <bool> device-connected: false;
    in-out property <string> device-status: "Suche Gerät …";

    // Rust bindet sich an diese Callbacks; siehe protocol.rs für die
    // Report-Builder-Funktionen pro Namespace.
    callback playback-param-changed(int, float);
    callback recording-param-changed(int, float);
    callback eq-param-changed(int, float);
    callback scout-toggled(bool);
    callback direct-mode-toggled(bool);
    callback decoder-mode-changed(int);
    callback mixer-level-changed(int, float);

    TabWidget {
        Tab {
            title: "Gerät";
            VerticalBox {
                alignment: start;
                Text {
                    text: "Sound Blaster G8";
                    font-size: 20px;
                    font-weight: 700;
                }
                Text {
                    text: device-connected ? "✓ Verbunden (USB 041e:329b, Vendor-HID Interface 4)" : device-status;
                    color: device-connected ? #2ecc71 : #e74c3c;
                }
                Text {
                    wrap: word-wrap;
                    text: "Sound-Modus-Presets, Firmware-Info und Treiber-Version sind über den proprietären Kanal noch nicht reverse-engineert (siehe HANDOFF.md, \"Offene Punkte\"). Master-Reset (SBX+HP/SPK 5s halten) und Firmware-Update laufen laut Anleitung rein am Gerät selbst ab.";
                }
            }
        }
        Tab {
            title: "Wiedergabe";
            VerticalLayout {
                // TODO: Kopfhörer/Lautsprecher-Umschalter, Format-Dropdown
                AcousticEngineTab {
                    param-changed(id, v) => { playback-param-changed(id, v); }
                }
            }
        }
        Tab {
            title: "Aufnahme";
            CrystalVoiceTab {
                param-changed(id, v) => { recording-param-changed(id, v); }
            }
        }
        Tab {
            title: "Effekte";
            TabWidget {
                Tab {
                    title: "Equalizer";
                    EqualizerTab {
                        param-changed(id, v) => { eq-param-changed(id, v); }
                    }
                }
                Tab {
                    title: "Scout Mode";
                    ScoutModeTab {
                        toggled(on) => { scout-toggled(on); }
                    }
                }
                Tab {
                    title: "Direct Mode";
                    DirectModeTab {
                        toggled(on) => { direct-mode-toggled(on); }
                    }
                }
                Tab {
                    title: "Decoder";
                    DecoderTab {
                        mode-changed(m) => { decoder-mode-changed(m); }
                    }
                }
            }
        }
        Tab {
            title: "Mixer";
            MixerTab {
                level-changed(id, v) => { mixer-level-changed(id, v); }
            }
        }
        Tab {
            title: "Einstellungen";
            VerticalBox {
                alignment: start;
                Text {
                    wrap: word-wrap;
                    text: "Volume Sync, Energiesparen und Logo-LED sind über den proprietären Kanal noch nicht reverse-engineert (kein Capture vorhanden). Sobald die 5a-Reports dafür bekannt sind, kommen sie hier als weitere Toggles rein.";
                }
            }
        }
    }
}
